<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- S6640: unsafe code is the point of this project (Win32 interop: window procedure, structs, pinned strings). -->
    <NoWarn>$(NoWarn);S6640</NoWarn>
    <PackageId>Atc.Desktop.WebHost.Windows</PackageId>
    <Description>Windows window for Atc.Desktop.WebHost: a plain Win32 window hosting WebView2.</Description>
    <PackageTags>desktop;webview;webview2;win32</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4314.35" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Atc.Desktop.WebHost\Atc.Desktop.WebHost.csproj" />
  </ItemGroup>

</Project>
